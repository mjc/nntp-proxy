classDiagram
    class NntpProxy {
        +BackendSelector router
        +DeadpoolConnectionProvider[] connection_providers
        +BufferPool buffer_pool
        +UnifiedCache cache
        +handle_client()
    }

    class ClientSession {
        +ClientId client_id
        +ModeState mode_state
        +AuthState auth_state
        +handle_per_command_routing()
        +run_stateful_proxy_loop()
    }

    class RequestContext {
        +RequestKind kind
        +RequestRouteClass route_class
        +has_response_body(status)
    }

    class CommandHandler {
        +classify_request(request, auth_access, routing_mode)
        +CommandPlan
    }

    class BackendSelector {
        +BackendSelectionStrategy strategy
        +route(request)
    }

    class DeadpoolConnectionProvider {
        +acquire() ConnectionGuard
        +shutdown()
    }

    class ConnectionGuard {
        +ConnectionStream stream
        +complete_success()
        +fail_backend()
    }

    class MultilineFramer {
        +RequestKind request_kind
        +write()
        +capture()
        +observe()
    }

    class BufferPool {
        +acquire() PooledBuffer
        +acquire_capture() PooledBuffer
    }

    class ConnectionStream {
        <<enumeration>>
        Plain
        Tls
        Compressed
    }

    class ModeState {
        +RoutingMode routing_mode
        +SessionMode mode
        +switch_to_stateful()
    }

    class AuthState {
        +authenticated()
        +username()
    }

    class SessionMode {
        <<enumeration>>
        PerCommand
        Stateful
    }

    class RoutingMode {
        <<enumeration>>
        Stateful
        PerCommand
        Hybrid
    }

    class UnifiedCache {
        +tracks_availability()
        +stores_payloads()
    }

    NntpProxy --> ClientSession : creates
    NntpProxy --> BackendSelector : owns
    NntpProxy --> DeadpoolConnectionProvider : owns many
    NntpProxy --> BufferPool : owns
    NntpProxy --> UnifiedCache : owns
    ClientSession --> ModeState : has
    ClientSession --> AuthState : has
    ClientSession --> RequestContext : parses
    RequestContext --> CommandHandler : classified by
    CommandHandler --> BackendSelector : routes
    BackendSelector --> ConnectionGuard : selects
    ConnectionGuard --> ConnectionStream : owns
    ConnectionGuard --> MultilineFramer : frames
    MultilineFramer --> BufferPool : borrows or captures
    ModeState --> SessionMode : tracks
    ModeState --> RoutingMode : configured with
