flowchart TB
    subgraph External["External"]
        Client["NNTP Client"]
        Backend1["Backend Server 1"]
        Backend2["Backend Server 2"]
        BackendN["Backend Server N"]
    end

    subgraph Proxy["NntpProxy"]
        direction TB
        Accept["Accept loop<br/>(runtime.rs)"]

        subgraph Session["ClientSession (session/)"]
            Auth["AuthState / AuthHandler"]
            Mode["ModeState<br/>Stateful / PerCommand / Hybrid"]
            Request["RequestContext<br/>(protocol/request.rs)"]
            Handler["CommandHandler<br/>(command/handler.rs)"]
            Framer["MultilineFramer<br/>(session/multiline_framing.rs)"]
        end

        Router["BackendSelector<br/>(router/)"]
        Pools["DeadpoolConnectionProvider<br/>ConnectionGuard"]
        Buffers["BufferPool / PooledBuffer<br/>(pool/)"]
        Cache["UnifiedCache<br/>(cache/)"]
        Metrics["MetricsCollector<br/>(metrics/)"]
        Stream["ConnectionStream<br/>(stream/)"]
    end

    Client -->|plain NNTP TCP| Accept
    Accept --> Session
    Auth --> Mode --> Request --> Handler
    Handler -->|route| Router
    Router --> Pools
    Pools --> Stream
    Stream -->|plain| Backend1
    Stream -->|TLS / compression| Backend2
    Stream --> BackendN
    Pools --> Buffers
    Request --> Framer
    Framer -->|borrow, capture, or cache| Client
    Framer --> Cache
    Session -.-> Metrics
